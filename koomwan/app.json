{
  "expo": {
    "name": "koomwan",
    "slug": "koomwan",
    "scheme": "koomwan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "แอปนี้ต้องการใช้กล้องของคุณเพื่อถ่ายรูปยา",
        "NSPhotoLibraryUsageDescription": "แอปนี้ต้องการเข้าถึงคลังรูปภาพของคุณเพื่อเลือกรูปภาพยา"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "package": "com.koomwan.client"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/K2D-Regular.ttf",
            "./assets/fonts/K2D-Bold.ttf",
            "./assets/fonts/K2D-Medium.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "แอปนี้ต้องการเข้าถึงคลังรูปภาพของคุณเพื่อเลือกรูปภาพยา",
          "cameraPermission": "แอปนี้ต้องการใช้กล้องของคุณเพื่อถ่ายรูปยา"
        }
      ],
      [
        "expo-file-system",
        {
          "fileSystemPermissions": {
            "ios": "The app needs to access your files to check image sizes",
            "android": "The app needs to access your files to check image sizes"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c08c3d54-38e6-4142-82fe-67d8545ef16b"
      }
    }
  }
}
